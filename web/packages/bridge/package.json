{
  "name": "@thru/bridge",
  "version": "0.0.1",
  "description": "TypeScript SDK for Polygon-to-Thru bridge deposits and withdrawals.",
  "license": "Apache-2.0",
  "homepage": "https://thru.org/docs/sdks/web/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unto-Labs/thru.git",
    "directory": "web/packages/bridge"
  },
  "bugs": {
    "url": "https://github.com/Unto-Labs/thru/issues"
  },
  "keywords": [
    "thru",
    "blockchain",
    "risc-v",
    "bridge",
    "polygon",
    "deposits"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@thru/sdk": "workspace:*",
    "ethers": "^6.16.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
