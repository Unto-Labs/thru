{
  "name": "@thru/server-telemetry",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": "./dist/index.js"
  },
  "scripts": {
    "test:run": "vitest run",
    "test": "vitest run",
    "typecheck": "tsc --ignoreConfig --noEmit --strict --skipLibCheck --moduleResolution bundler --module esnext --target es2022 src/index.ts src/index.test.ts",
    "build": "tsup src/index.ts --format esm --platform node --target node22 --dts"
  },
  "dependencies": {
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "tsup": "^8.5.1"
  }
}
