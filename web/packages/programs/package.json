{
  "name": "@thru/programs",
  "version": "0.0.1",
  "description": "Typed TypeScript clients for Thru's core on-chain programs: token, AMM, CLOB, oracle, multicall, Wallet Program, and others.",
  "license": "Apache-2.0",
  "homepage": "https://thru.org/docs/sdks/web-packages/programs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unto-Labs/thru.git",
    "directory": "web/packages/programs"
  },
  "bugs": {
    "url": "https://github.com/Unto-Labs/thru/issues"
  },
  "keywords": [
    "thru",
    "blockchain",
    "risc-v",
    "token",
    "amm",
    "clob",
    "oracle",
    "abi"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./bootstrap-addresses": {
      "types": "./dist/bootstrap-addresses/index.d.ts",
      "import": "./dist/bootstrap-addresses/index.js",
      "require": "./dist/bootstrap-addresses/index.cjs"
    },
    "./token": {
      "types": "./dist/token/index.d.ts",
      "import": "./dist/token/index.js",
      "require": "./dist/token/index.cjs"
    },
    "./passkey-manager": {
      "types": "./dist/passkey-manager/index.d.ts",
      "import": "./dist/passkey-manager/index.js",
      "require": "./dist/passkey-manager/index.cjs"
    },
    "./wallet": {
      "types": "./dist/wallet/index.d.ts",
      "import": "./dist/wallet/index.js",
      "require": "./dist/wallet/index.cjs"
    },
    "./multicall": {
      "types": "./dist/multicall/index.d.ts",
      "import": "./dist/multicall/index.js",
      "require": "./dist/multicall/index.cjs"
    },
    "./amm": {
      "types": "./dist/amm/index.d.ts",
      "import": "./dist/amm/index.js",
      "require": "./dist/amm/index.cjs"
    },
    "./clob": {
      "types": "./dist/clob/index.d.ts",
      "import": "./dist/clob/index.js",
      "require": "./dist/clob/index.cjs"
    },
    "./oracle": {
      "types": "./dist/oracle/index.d.ts",
      "import": "./dist/oracle/index.js",
      "require": "./dist/oracle/index.cjs"
    },
    "./manager": {
      "types": "./dist/manager/index.d.ts",
      "import": "./dist/manager/index.js",
      "require": "./dist/manager/index.cjs"
    },
    "./abi-manager": {
      "types": "./dist/abi-manager/index.d.ts",
      "import": "./dist/abi-manager/index.js",
      "require": "./dist/abi-manager/index.cjs"
    },
    "./uploader": {
      "types": "./dist/uploader/index.d.ts",
      "import": "./dist/uploader/index.js",
      "require": "./dist/uploader/index.cjs"
    },
    "./deploy": {
      "types": "./dist/deploy/index.d.ts",
      "import": "./dist/deploy/index.js",
      "require": "./dist/deploy/index.cjs"
    },
    "./perps": {
      "import": {
        "types": "./dist/perps/index.d.ts",
        "default": "./dist/perps/index.js"
      },
      "require": {
        "types": "./dist/perps/index.d.cts",
        "default": "./dist/perps/index.cjs"
      }
    },
    "./perp": {
      "import": {
        "types": "./dist/perps/index.d.ts",
        "default": "./dist/perps/index.js"
      },
      "require": {
        "types": "./dist/perps/index.d.cts",
        "default": "./dist/perps/index.cjs"
      }
    },
    "./perps/testing": {
      "import": {
        "types": "./dist/perps/testing.d.ts",
        "default": "./dist/perps/testing.js"
      },
      "require": {
        "types": "./dist/perps/testing.d.cts",
        "default": "./dist/perps/testing.cjs"
      }
    },
    "./compression": {
      "types": "./dist/compression/index.d.ts",
      "import": "./dist/compression/index.js",
      "require": "./dist/compression/index.cjs"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "import": "./dist/resources.js",
      "require": "./dist/resources.cjs"
    },
    "./faucet": {
      "types": "./dist/faucet/index.d.ts",
      "import": "./dist/faucet/index.js",
      "require": "./dist/faucet/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "pnpm run test:run",
    "test:run": "vitest run && pnpm run test:compatibility && pnpm run test:pack",
    "test:compatibility": "node scripts/check-wallet-compatibility.mjs",
    "test:pack": "node scripts/check-perps-pack.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@thru/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
