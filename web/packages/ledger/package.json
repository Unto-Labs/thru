{
  "name": "@thru/ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Ledger hardware-wallet signer for Thru, built on the Ledger Device Management Kit (DMK): APDU commands for the Thru device app, typed errors, and an adapter into the Thru SDK external-signer flow.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unto-Labs/thru.git",
    "directory": "web/packages/ledger"
  },
  "bugs": {
    "url": "https://github.com/Unto-Labs/thru/issues"
  },
  "keywords": [
    "thru",
    "blockchain",
    "ledger",
    "hardware-wallet",
    "dmk",
    "signer"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "require": "./dist/protocol.cjs"
    },
    "./webhid": {
      "types": "./dist/webhid.d.ts",
      "import": "./dist/webhid.js",
      "require": "./dist/webhid.cjs"
    },
    "./speculos": {
      "types": "./dist/speculos.d.ts",
      "import": "./dist/speculos.js",
      "require": "./dist/speculos.cjs"
    },
    "./node-hid": {
      "types": "./dist/node-hid.d.ts",
      "import": "./dist/node-hid.js",
      "require": "./dist/node-hid.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:speculos": "vitest run src/__tests__/speculos.integration.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@thru/sdk": "workspace:*"
  },
  "peerDependencies": {
    "@ledgerhq/device-management-kit": "^1.11.0",
    "@ledgerhq/device-transport-kit-speculos": "^1.3.0",
    "@ledgerhq/device-transport-kit-web-hid": "^1.2.4",
    "rxjs": "7.8.2"
  },
  "peerDependenciesMeta": {
    "@ledgerhq/device-transport-kit-speculos": {
      "optional": true
    },
    "@ledgerhq/device-transport-kit-web-hid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@ledgerhq/device-management-kit": "1.11.0",
    "@ledgerhq/device-transport-kit-speculos": "1.3.0",
    "@ledgerhq/device-transport-kit-web-hid": "1.2.4",
    "@types/node": "^25.9.1",
    "eslint": "^9.39.4",
    "purify-ts": "2.1.0",
    "rxjs": "7.8.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.7"
  }
}
