{
  "name": "@thru/replay",
  "version": "0.1.0",
  "description": "Gap-free historical plus live replay of Thru blocks, transactions, accounts, and events for ETL and analytics pipelines.",
  "license": "Apache-2.0",
  "homepage": "https://thru.org/docs/sdks/web-packages/replay/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unto-Labs/thru.git",
    "directory": "web/packages/replay"
  },
  "bugs": {
    "url": "https://github.com/Unto-Labs/thru/issues"
  },
  "keywords": [
    "thru",
    "blockchain",
    "risc-v",
    "replay",
    "etl",
    "streaming",
    "grpc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "run:block-replay": "tsx scripts/run-block-replay.ts",
    "run:token-events": "tsx scripts/replay-token-events.ts",
    "run:token-accounts": "tsx scripts/stream-token-accounts.ts",
    "run:replays": "tsx scripts/run-replays.ts",
    "test:list-accounts": "tsx scripts/test-list-accounts.ts",
    "test:backfill": "tsx scripts/test-account-backfill.ts",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:run": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@thru/sdk": "workspace:*",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
