{
  "name": "thru-workspace",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present --filter './packages/*' --filter './packages-private/*' --filter './clob/packages/*' --filter './clob/apps/*' --filter './wallet/admin' --filter './wallet/frontend/packages/*' --filter './wallet/packages/*' --filter './faucet' test:run",
    "test:watch": "pnpm -r --if-present --filter './packages/*' --filter './packages-private/*' --filter './clob/packages/*' --filter './clob/apps/*' --filter './wallet/admin' --filter './wallet/frontend/packages/*' --filter './wallet/packages/*' test:watch",
    "test:coverage": "pnpm -r --if-present --filter './packages/*' --filter './packages-private/*' --filter './clob/packages/*' --filter './clob/apps/*' --filter './wallet/admin' --filter './wallet/frontend/packages/*' --filter './wallet/packages/*' test:coverage",
    "test:wallet": "pnpm --filter thru-wallet test",
    "test:sdk": "pnpm --filter @thru/sdk test",
    "unifold": "pnpm --filter @thru/unifold-automation roundtrip",
    "test:mobile-qa": "pnpm --dir passkey-demo-dapp test:mobile-qa",
    "test:mobile-qa:wallet-auth": "pnpm --dir passkey-demo-dapp test:mobile-qa:wallet-auth",
    "test:mobile-qa:unit": "pnpm --dir passkey-demo-dapp test:mobile-qa:unit"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@vitest/coverage-v8": "^4.1.7",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@bufbuild/buf",
      "esbuild"
    ],
    "overrides": {
      "axios@<1.18.0": "^1.18.0",
      "brace-expansion@<1.1.18": "^1.1.18",
      "brace-expansion@>=4.0.0 <5.0.9": "^5.0.9",
      "esbuild@<0.25.0": "^0.25.0",
      "fast-uri@>=3.0.0 <3.1.5": "^3.1.5",
      "ip-address@<10.3.1": "^10.3.1",
      "js-yaml@<3.15.1": "^3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
      "nanoid@<3.3.18": "^3.3.18",
      "next@>=16.0.0 <16.2.11": "16.2.11",
      "postcss@<8.5.18": "^8.5.18",
      "sharp@<0.35.0": "^0.35.0",
      "shell-quote@<1.9.0": "^1.9.0",
      "undici@>=7.0.0 <7.29.0": "^7.29.0",
      "uuid@<11.1.1": ">=11.1.1",
      "vite@>=7.0.0 <7.3.5": "^7.3.5",
      "ws@>=8.0.0 <8.21.0": "^8.21.0"
    },
    "patchedDependencies": {
      "liveline": "patches/liveline.patch"
    }
  }
}
