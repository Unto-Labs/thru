{
  "name": "thru-workspace",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present --filter './packages/*' --filter './packages-private/*' --filter './compression-service' --filter './indexers/packages/*' --filter './indexers/*/apps/*' --filter './indexers/*/packages/*' --filter './perps/*' --filter './wallet/admin' --filter './wallet/frontend/packages/*' --filter './wallet/packages/*' --filter './faucet' --filter './platform' --filter './wallet-app' test:run",
    "test:watch": "pnpm -r --if-present --filter './packages/*' --filter './packages-private/*' --filter './compression-service' --filter './indexers/packages/*' --filter './indexers/*/apps/*' --filter './indexers/*/packages/*' --filter './wallet/admin' --filter './wallet/frontend/packages/*' --filter './wallet/packages/*' test:watch",
    "test:coverage": "pnpm -r --if-present --filter './packages/*' --filter './packages-private/*' --filter './compression-service' --filter './indexers/packages/*' --filter './indexers/*/apps/*' --filter './indexers/*/packages/*' --filter './wallet/admin' --filter './wallet/frontend/packages/*' --filter './wallet/packages/*' test:coverage",
    "test:wallet": "pnpm --filter thru-wallet test",
    "test:sdk": "pnpm --filter @thru/sdk test",
    "unifold": "pnpm --filter @thru/unifold-automation roundtrip",
    "test:mobile-qa": "pnpm --dir wallet-app test:mobile-qa",
    "test:mobile-qa:wallet-auth": "pnpm --dir wallet-app test:mobile-qa:wallet-auth",
    "test:mobile-qa:unit": "pnpm --dir wallet-app test:mobile-qa:unit"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@bufbuild/buf",
      "esbuild"
    ],
    "overrides": {
      "@expo/metro@>=55.0.0 <55.1.2": "~55.1.2",
      "@expo/metro@>=56.0.0 <56.0.2": "~56.0.2",
      "@xmldom/xmldom@>=0.7.0 <0.8.15": "^0.8.15",
      "@xmldom/xmldom@>=0.9.0 <0.9.12": "^0.9.12",
      "axios@<1.20.0": "^1.20.0",
      "brace-expansion@<1.1.18": "^1.1.18",
      "brace-expansion@>=4.0.0 <5.0.9": "^5.0.9",
      "browserslist@<4.28.7": "^4.28.7",
      "compression@<1.8.2": "^1.8.2",
      "esbuild@<0.25.0": "^0.25.0",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
      "ip-address@<10.3.1": "^10.3.1",
      "js-yaml@<3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "metro-config@>=0.83.0 <0.83.8": "0.83.8",
      "metro-config@>=0.84.0 <0.84.5": "0.84.5",
      "metro-core@>=0.83.0 <0.83.8": "0.83.8",
      "metro-core@>=0.84.0 <0.84.5": "0.84.5",
      "metro-runtime@>=0.83.0 <0.83.8": "0.83.8",
      "metro-runtime@>=0.84.0 <0.84.5": "0.84.5",
      "metro-source-map@>=0.83.0 <0.83.8": "0.83.8",
      "metro-source-map@>=0.84.0 <0.84.5": "0.84.5",
      "metro@>=0.83.0 <0.83.8": "0.83.8",
      "metro@>=0.84.0 <0.84.5": "0.84.5",
      "nanoid@<3.3.18": "^3.3.18",
      "next@>=16.0.0 <16.4.3": "16.4.3",
      "postcss@<8.5.18": "^8.5.18",
      "proxy-addr@<2.0.8": "^2.0.8",
      "sharp@<0.35.5": "^0.35.5",
      "shell-quote@<1.11.0": "^1.11.0",
      "undici@>=7.0.0 <7.29.0": "^7.29.0",
      "uuid@<11.1.1": ">=11.1.1",
      "vite@>=7.0.0 <7.3.5": "^7.3.5",
      "ws@>=8.0.0 <8.21.0": "^8.21.0"
    },
    "patchedDependencies": {
      "@swmansion/argent@0.27.0": "patches/@swmansion__argent@0.27.0.patch",
      "@unifold/connect-react@0.1.80": "patches/@unifold__connect-react@0.1.80.patch",
      "@connectrpc/connect-node@2.1.1": "patches/@connectrpc__connect-node@2.1.1.patch",
      "expo-router@55.0.17": "patches/expo-router@55.0.17.patch"
    }
  }
}
